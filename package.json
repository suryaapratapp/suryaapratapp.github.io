{
  "name": "kd-enterprises-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/site.css --minify",
    "build:js": "esbuild ./src/app.jsx --bundle --minify --target=es2020 --format=iife --outfile=./assets/app.js",
    "build": "npm run build:css && npm run build:js",
    "dev": "npx serve ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.17"
  }
}
