{
  "name": "kd-enterprises-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/site.css --minify",
    "build:js": "esbuild ./src/app.jsx --bundle --minify --target=es2020 --format=iife --outfile=./assets/app.js",
    "build:seo": "node scripts/generate_seo_pages.mjs",
    "build:public": "rm -rf public && mkdir public && cp index.html logo-kde.png robots.txt sitemap.xml public/ && cp -R assets products materials public/",
    "build": "npm run build:css && npm run build:js && npm run build:seo && npm run build:public",
    "dev": "npx serve ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.17"
  }
}
